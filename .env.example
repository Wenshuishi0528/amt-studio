# Copy to .env only when needed. Never commit .env.

# Mac project locations
AMT_PROJECTS_ROOT=projects/private
AMT_MODEL_CACHE=model-cache

# Hyak defaults. Override after verifying your account and storage.
HYAK_HOST=klone.hyak.uw.edu
HYAK_ACCOUNT=stf
HYAK_GPU_PARTITION=gpu-l40
HYAK_PERSIST_ROOT=/gscratch/stf/$USER/amt-studio
HYAK_SCRATCH_ROOT=/gscratch/scrubbed/$USER/amt-studio

# Optional external tools
FLUIDSYNTH_SOUNDFONT=
