{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/amt-studio/evaluation_candidate_set.schema.json",
  "title": "AMT Studio sealed evaluation candidate set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "freeze_payload",
    "candidate_set_sha256",
    "claims"
  ],
  "properties": {
    "schema": {
      "const": "amt-evaluation-candidate-set-seal/v1"
    },
    "freeze_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "benchmark_freeze_sha256",
        "split",
        "frozen_at",
        "candidates",
        "confirmation"
      ],
      "properties": {
        "schema": {
          "const": "amt-evaluation-candidate-set/v1"
        },
        "benchmark_freeze_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "split": {
          "enum": [
            "train",
            "development",
            "blind_test"
          ]
        },
        "frozen_at": {
          "type": "string",
          "minLength": 1
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "run_id",
              "worker",
              "events_path",
              "events_sha256",
              "run_manifest_path",
              "run_manifest_sha256"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "run_id": {
                "type": "string",
                "minLength": 1
              },
              "worker": {
                "type": "string",
                "minLength": 1
              },
              "events_path": {
                "type": "string",
                "minLength": 1
              },
              "events_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "run_manifest_path": {
                "type": "string",
                "minLength": 1
              },
              "run_manifest_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "confirmation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "candidate_output_quality_uninspected_before_freeze",
            "candidate_selection_or_tuning_after_freeze_prohibited"
          ],
          "properties": {
            "candidate_output_quality_uninspected_before_freeze": {
              "const": true
            },
            "candidate_selection_or_tuning_after_freeze_prohibited": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "candidate_set_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blind_result_eligible",
        "quality_inspection_recorded_by_this_tool"
      ],
      "properties": {
        "blind_result_eligible": {
          "type": "boolean"
        },
        "quality_inspection_recorded_by_this_tool": {
          "const": false
        }
      }
    }
  }
}
